# Copie para .env.local e preencha com as chaves do seu projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# ------- Mensagens automáticas (confirmação + lembrete) -------
# URL pública do app (para os links de confirmação nos e-mails/WhatsApp)
APP_URL=https://seu-dominio.com
# Segredo para assinar os links de confirmação (gere uma string aleatória longa)
NOTIFY_SECRET=
# Protege o endpoint de cron (a Vercel envia como Authorization: Bearer CRON_SECRET)
CRON_SECRET=
# service_role do Supabase — SERVIDOR APENAS, NUNCA no cliente (Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (Resend: crie conta, verifique um domínio de envio)
RESEND_API_KEY=
EMAIL_FROM=AyA <nao-responda@seu-dominio.com>

# WhatsApp (opcional; ative quando tiver a API oficial e os templates aprovados)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WA_TEMPLATE_CONFIRM=confirmacao_sessao
WA_TEMPLATE_REMINDER=lembrete_sessao
